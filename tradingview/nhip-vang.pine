//@version=5
// Nhịp Vàng: tín hiệu XAUUSD 3 khung chạy trực tiếp trên TradingView (cùng quy tắc với engine/gold.py).
// Cách dùng: mở biểu đồ OANDA:XAUUSD khung 15 phút → Pine Editor → dán toàn bộ → Add to chart.
// Cảnh báo: Alerts → Create alert → Condition "Nhịp Vàng" → "Any alert() function call" → bật thông báo app/email.
// Quy tắc (chỉ dùng nến khung lớn đã đóng):
//   H4  xu hướng: Tăng khi giá > EMA50 > EMA200, Giảm khi ngược lại.
//   H1  vùng: MUA khi EMA20 > EMA50, giá trên EMA50, đã chạm EMA20 trong 3 nến H1 gần nhất, RSI < 70 (BÁN ngược lại).
//   M15 vào lệnh NGAY ở giá đóng cửa nến quét thanh khoản (không chờ giá chạy), theo chiều H4, bỏ 21h–3h giờ VN:
//     A. Quét đáy 20 nến: nến (hiện tại hoặc trước) chọc thủng đáy 20 nến trước đó, nến hiện tại đóng cửa quay lại
//        và là nến tăng, H1 đang ở vùng MUA, RSI M15 <= 50: MUA.
//     B. Quét 2–3 đáy + phân kỳ RSI: chọc thủng (không quá 0,6 ATR) một đáy xoay chiều cũ còn nguyên trong 24 giờ
//        rồi đóng cửa quay lên, nến tăng, RSI tạo đáy cao hơn: MUA. BÁN ngược lại với đỉnh.
//   SL sau râu nến quét + 0,1 ATR, tối thiểu 10 giá, bỏ tín hiệu nếu cần hơn 15 giá.
//   Tới 1:1 dời SL về giá vào; từ 1:3 kéo SL luôn cách mức lãi cao nhất 1,5R; chốt hết ở 1:8.
// Hệ 2 (song song): phá đỉnh/đáy 20 nến H1 theo H4, vào ngay, SL 2 ATR H1, cùng cách dời SL/kéo SL/chốt tối đa.
// Tín hiệu tham khảo, không phải lời khuyên đầu tư.
indicator("Nhịp Vàng · H4 xu hướng · H1 vùng · M15 quét thanh khoản", shorttitle = "Nhịp Vàng", overlay = true, max_labels_count = 500, max_boxes_count = 500, max_lines_count = 500)

tpR       = input.float(8.0, "Chốt tối đa (R)", minval = 2, step = 0.5)
trailAt   = input.float(3.0, "Bắt đầu kéo SL khi đạt (R)", minval = 1, step = 0.5)
trailGap  = input.float(1.5, "Kéo SL cách mức lãi cao nhất (R)", minval = 0.5, step = 0.5)
beR       = input.float(1.0, "Dời SL về giá vào khi đạt (R)", minval = 0.5, step = 0.5)
look      = input.int(20, "Số nến M15 tìm đáy/đỉnh thanh khoản", minval = 5)
minRisk   = input.float(10, "SL tối thiểu (giá, quy về mức 3.850)")
maxRisk   = input.float(15, "SL tối đa (giá, quy về mức 3.850)")
bufAtr    = input.float(0.1, "Đệm SL sau râu nến (ATR)", step = 0.05)
rsiMax    = input.int(50, "Lọc: MUA khi RSI M15 ≤ (BÁN khi ≥ 100 − số này)", minval = 30, maxval = 100)
usePat    = input.bool(true, "Kiểu B: quét 2–3 đáy/đỉnh + phân kỳ RSI")
pivK      = 3
pivWin    = input.int(96, "Kiểu B: tìm đáy/đỉnh cũ trong (số nến M15)", minval = 20)
pivGap    = 5
tolAtr    = input.float(0.6, "Kiểu B: quét sâu tối đa (ATR)", minval = 0.1, step = 0.1)
useHours  = input.bool(true, "Lọc: bỏ vào lệnh từ 21h đến trước 3h (giờ VN)")
showTable = input.bool(true, "Hiện bảng trạng thái")
showHist  = input.bool(true, "Giữ vùng SL/TP của các lệnh đã đóng")
cUp       = input.color(color.new(#089981, 0), "Màu chốt lời")
cDn       = input.color(color.new(#F23645, 0), "Màu dừng lỗ")

// ---------- Khung lớn: lấy giá trị của nến ĐÃ ĐÓNG (không vẽ lại) ----------
trend4() =>
    e50 = ta.ema(close, 50)
    e200 = ta.ema(close, 200)
    v = close > e50 and e50 > e200 ? 1 : close < e50 and e50 < e200 ? -1 : 0
    v[1]

zone1() =>
    e20 = ta.ema(close, 20)
    e50 = ta.ema(close, 50)
    r = ta.rsi(close, 14)
    touchDn = ta.lowest(low - e20, 3) <= 0
    touchUp = ta.highest(high - e20, 3) >= 0
    v = e20 > e50 and close > e50 and touchDn and r < 70 ? 1 : e20 < e50 and close < e50 and touchUp and r > 30 ? -1 : 0
    v[1]

h4 = request.security(syminfo.tickerid, "240", trend4(), lookahead = barmerge.lookahead_on)
h1 = request.security(syminfo.tickerid, "60", zone1(), lookahead = barmerge.lookahead_on)

// ---------- M15: quét thanh khoản ----------
atr   = ta.atr(14)
liqLo = ta.lowest(low[2], look)
liqHi = ta.highest(high[2], look)
wLo   = math.min(low, low[1])
wHi   = math.max(high, high[1])
sc    = close / 3850.0
rsi15 = ta.rsi(close, 14)
hVN   = hour(time, "Asia/Ho_Chi_Minh")
hourOk = not useHours or not (hVN >= 21 or hVN < 3)
// Kiểu A: quét đáy/đỉnh 20 nến trong vùng H1 cùng chiều H4
aBuy  = h4 == 1 and h1 == 1 and wLo < liqLo and close > liqLo and close > open and rsi15 <= rsiMax
aSell = h4 == -1 and h1 == -1 and wHi > liqHi and close < liqHi and close < open and rsi15 >= 100 - rsiMax

// Kiểu B: quét đáy/đỉnh xoay chiều còn nguyên (2 đáy; có thêm đáy ngang bằng = 3 đáy) + phân kỳ RSI
var array<int>   loI = array.new<int>()
var array<float> loP = array.new<float>()
var array<float> loR = array.new<float>()
var array<float> loM = array.new<float>()   // giá thấp nhất từ sau đáy đến 2 nến trước nến hiện tại
var array<int>   hiI = array.new<int>()
var array<float> hiP = array.new<float>()
var array<float> hiR = array.new<float>()
var array<float> hiM = array.new<float>()
isPL = bar_index >= 2 * pivK + 1 and low[pivK] == ta.lowest(low, 2 * pivK + 1)
isPH = bar_index >= 2 * pivK + 1 and high[pivK] == ta.highest(high, 2 * pivK + 1)
rsiP = rsi15[pivK]
if isPL
    array.push(loI, bar_index - pivK)
    array.push(loP, low[pivK])
    array.push(loR, rsiP)
    array.push(loM, 1e10)
if isPH
    array.push(hiI, bar_index - pivK)
    array.push(hiP, high[pivK])
    array.push(hiR, rsiP)
    array.push(hiM, -1e10)
while array.size(loI) > 0 and bar_index - array.get(loI, 0) > pivWin
    array.shift(loI)
    array.shift(loP)
    array.shift(loR)
    array.shift(loM)
while array.size(hiI) > 0 and bar_index - array.get(hiI, 0) > pivWin
    array.shift(hiI)
    array.shift(hiP)
    array.shift(hiR)
    array.shift(hiM)
low2 = low[2]
high2 = high[2]
rsiLo = math.min(rsi15, rsi15[1])
rsiHi = math.max(rsi15, rsi15[1])
if array.size(loI) > 0
    for k = 0 to array.size(loI) - 1
        if bar_index - 2 > array.get(loI, k)
            array.set(loM, k, math.min(array.get(loM, k), low2))
if array.size(hiI) > 0
    for k = 0 to array.size(hiI) - 1
        if bar_index - 2 > array.get(hiI, k)
            array.set(hiM, k, math.max(array.get(hiM, k), high2))
tol = tolAtr * atr
bDir = 0
float bLvl = na
int bCnt = 0
bool bDiv = false
if close > open and array.size(loI) > 0
    int c1 = -1
    for k = 0 to array.size(loI) - 1
        p = array.get(loP, k)
        if bar_index - array.get(loI, k) >= pivGap and array.get(loM, k) > p and wLo < p and p <= wLo + tol and close > p
            if c1 < 0 or p < array.get(loP, c1)
                c1 := k
    if c1 >= 0
        p1 = array.get(loP, c1)
        peer = false
        for k = 0 to array.size(loI) - 1
            q = array.get(loP, k)
            if array.get(loI, k) < array.get(loI, c1) and math.abs(q - p1) <= tol and array.get(loM, k) >= p1 - tol and q > wLo
                peer := true
        bDir := 1
        bLvl := p1
        bCnt := peer ? 3 : 2
        bDiv := rsiLo > array.get(loR, c1)
if bDir == 0 and close < open and array.size(hiI) > 0
    int c1 = -1
    for k = 0 to array.size(hiI) - 1
        p = array.get(hiP, k)
        if bar_index - array.get(hiI, k) >= pivGap and array.get(hiM, k) < p and wHi > p and p >= wHi - tol and close < p
            if c1 < 0 or p > array.get(hiP, c1)
                c1 := k
    if c1 >= 0
        p1 = array.get(hiP, c1)
        peer = false
        for k = 0 to array.size(hiI) - 1
            q = array.get(hiP, k)
            if array.get(hiI, k) < array.get(hiI, c1) and math.abs(q - p1) <= tol and array.get(hiM, k) <= p1 + tol and q < wHi
                peer := true
        bDir := -1
        bLvl := p1
        bCnt := peer ? 3 : 2
        bDiv := rsiHi < array.get(hiR, c1)
bOk = usePat and bDir != 0 and bDiv and bDir == h4

sigDir0 = aBuy ? 1 : aSell ? -1 : bOk ? bDir : 0
sigWick = sigDir0 == 1 ? wLo : wHi
sigLvl  = aBuy ? liqLo : aSell ? liqHi : bLvl
sigKind = aBuy ? "Quét đáy 20 nến" : aSell ? "Quét đỉnh 20 nến" : "Quét " + str.tostring(bCnt) + (bDir == 1 ? " đáy" : " đỉnh") + " + phân kỳ RSI"
sigRisk = math.max(sigDir0 * (close - sigWick) + bufAtr * atr, minRisk * sc)
sigDir  = barstate.isconfirmed and hourOk and sigDir0 != 0 and sigRisk <= maxRisk * sc ? sigDir0 : 0

// Đáy/đỉnh cũ còn nguyên gần giá nhất (để theo dõi trên bảng)
float watchLo = na
float watchHi = na
if array.size(loI) > 0
    for k = 0 to array.size(loI) - 1
        p = array.get(loP, k)
        if math.min(array.get(loM, k), low, wLo) > p and p < close and (na(watchLo) or p > watchLo)
            watchLo := p
if array.size(hiI) > 0
    for k = 0 to array.size(hiI) - 1
        p = array.get(hiP, k)
        if math.max(array.get(hiM, k), high, wHi) < p and p > close and (na(watchHi) or p < watchHi)
            watchHi := p

// ---------- Quản lý lệnh (giống engine/gold.py) ----------
var int   pos    = 0
var float entry  = na
var float sl     = na
var float sl0    = na
var float be     = na
var float trl    = na
var float tp     = na
var float risk   = na
var float mx     = 0.0
var bool  t1     = false
var bool  trailing = false
var string kindNow = ""
var int   nWin   = 0
var int   nBe    = 0
var int   nLoss  = 0
var float totR   = 0.0
f(x) => str.tostring(x, format.mintick)
sideTxt(d) => d == 1 ? "MUA" : "BÁN"

// Vùng SL (đỏ) và vùng tới mốc kéo SL 1:3 (xanh), đường tối đa 1:8, nhãn giá ở mép phải
var box   bxSl = na
var box   bxTp = na
var line  lnEn = na
var line  lnBe = na
var line  lnTp = na
var label lbSl = na
var label lbTr = na
var label lbTp = na
var label lbEn = na
var label lbBe = na

float exitR = na
string why = ""
bool busy = pos != 0   // đang giữ lệnh ở đầu nến này: không vào lệnh mới trong cùng nến
if pos != 0
    fav = pos * ((pos == 1 ? high : low) - entry) / risk
    hitSl = pos == 1 ? low <= sl : high >= sl
    if hitSl
        exitR := pos * (sl - entry) / risk
        why := exitR < 0 ? "Chạm dừng lỗ" : exitR == 0 ? "Về giá vào (hoà vốn)" : "Chạm SL đã kéo theo lãi"
    else if fav >= tpR
        exitR := tpR
        why := "Đạt tối đa 1:" + str.tostring(tpR)
    else
        mx := math.max(mx, fav)
        if fav >= beR and pos * (entry - sl) > 0
            sl := entry
            t1 := true
            alert("XAUUSD: lệnh " + sideTxt(pos) + " từ " + f(entry) + " đạt 1:1 tại " + f(be) + ", dời dừng lỗ về giá vào", alert.freq_once_per_bar)
        if mx >= trailAt
            nsl = entry + pos * (mx - trailGap) * risk
            if pos * (nsl - sl) > 0
                if not trailing
                    alert("XAUUSD: lệnh " + sideTxt(pos) + " đạt 1:" + str.tostring(trailAt) + " tại " + f(trl) + ", bắt đầu kéo dừng lỗ", alert.freq_once_per_bar)
                trailing := true
                sl := nsl

if not na(exitR)
    nWin  += exitR > 0 ? 1 : 0
    nBe   += exitR == 0 ? 1 : 0
    nLoss += exitR < 0 ? 1 : 0
    totR  += exitR
    alert("XAUUSD: " + why + " · lệnh " + sideTxt(pos) + " từ " + f(entry) + " · " + str.tostring(exitR, "#.##") + "R", alert.freq_once_per_bar)
    box.set_right(bxSl, bar_index)
    box.set_right(bxTp, bar_index)
    line.set_x2(lnEn, bar_index)
    line.delete(lnBe)
    line.delete(lnTp)
    label.delete(lbSl)
    label.delete(lbTr)
    label.delete(lbTp)
    label.delete(lbEn)
    label.delete(lbBe)
    label.new(bar_index, exitR > 0 ? (pos == 1 ? high : low) : exitR < 0 ? sl0 : entry, (exitR > 0 ? "+" : "") + str.tostring(exitR, "#.##") + "R", style = label.style_label_center, color = exitR > 0 ? cUp : exitR < 0 ? cDn : color.gray, textcolor = color.white, size = size.small)
    if not showHist
        box.delete(bxSl)
        box.delete(bxTp)
        line.delete(lnEn)
    pos := 0

// Tín hiệu mới: VÀO NGAY ở giá đóng cửa nến quét
bool opened = false
if sigDir != 0 and pos == 0 and not busy
    opened := true
    pos   := sigDir
    entry := close
    risk  := sigRisk
    sl    := entry - pos * risk
    sl0   := sl
    be    := entry + pos * beR * risk
    trl   := entry + pos * trailAt * risk
    tp    := entry + pos * tpR * risk
    mx    := 0.0
    t1    := false
    trailing := false
    kindNow := sigKind
    alert("XAUUSD " + sideTxt(pos) + " NGAY " + f(entry) + " | " + sigKind + " tại " + f(sigLvl) + " | SL " + f(sl) + " (−" + f(risk) + ") | Hoà vốn tại " + f(be) + " | Kéo SL từ " + f(trl) + " | Tối đa 1:" + str.tostring(tpR) + " " + f(tp), alert.freq_once_per_bar_close)
    bxSl := box.new(bar_index, math.max(entry, sl), bar_index + 1, math.min(entry, sl), border_color = cDn, bgcolor = color.new(cDn, 82))
    bxTp := box.new(bar_index, math.max(entry, trl), bar_index + 1, math.min(entry, trl), border_color = cUp, bgcolor = color.new(cUp, 82))
    lnEn := line.new(bar_index, entry, bar_index + 1, entry, color = color.gray, width = 2)
    lnBe := line.new(bar_index, be, bar_index + 1, be, color = color.new(color.gray, 30), style = line.style_dashed)
    lnTp := line.new(bar_index, tp, bar_index + 1, tp, color = cUp, style = line.style_dashed)
    lbSl := label.new(bar_index + 1, sl, "", style = label.style_label_left, color = cDn, textcolor = color.white, size = size.small)
    lbTr := label.new(bar_index + 1, trl, "", style = label.style_label_left, color = cUp, textcolor = color.white, size = size.small)
    lbTp := label.new(bar_index + 1, tp, "", style = label.style_label_left, color = color.new(cUp, 30), textcolor = color.white, size = size.small)
    lbEn := label.new(bar_index + 1, entry, "", style = label.style_label_left, color = color.gray, textcolor = color.white, size = size.small)
    lbBe := label.new(bar_index + 1, be, "", style = label.style_label_left, color = color.new(color.gray, 40), textcolor = color.white, size = size.small)
    line.new(bar_index - 6, sigLvl, bar_index, sigLvl, color = pos == 1 ? cUp : cDn, style = line.style_dotted)

// Lệnh đang mở: kéo dài vùng màu và cập nhật nhãn ở mép phải
if pos != 0
    x = bar_index + 3
    box.set_right(bxSl, x)
    box.set_right(bxTp, x)
    line.set_x2(lnEn, x)
    line.set_x2(lnBe, x)
    line.set_x2(lnTp, x)
    label.set_xy(lbTp, x, tp)
    label.set_text(lbTp, "TỐI ĐA 1:" + str.tostring(tpR) + "  " + f(tp))
    label.set_xy(lbTr, x, trl)
    label.set_text(lbTr, (trailing ? "ĐANG KÉO SL ✓ (từ " : "KÉO SL TỪ ") + f(trl) + (trailing ? ")" : "  (1:" + str.tostring(trailAt) + ", +" + f(math.abs(trl - entry)) + ")"))
    label.set_xy(lbSl, x, sl)
    label.set_text(lbSl, (trailing ? "SL ĐANG KÉO " : t1 ? "SL ĐÃ VỀ GIÁ VÀO " : "DỪNG LỖ ") + f(sl) + (t1 or trailing ? "" : "  (−" + f(math.abs(entry - sl)) + ")"))
    label.set_xy(lbEn, x, entry)
    label.set_text(lbEn, sideTxt(pos) + " " + f(entry) + " · " + kindNow)
    label.set_xy(lbBe, x, be)
    label.set_text(lbBe, t1 ? "Đã đạt 1:1 ✓" : "Dời SL hoà vốn " + f(be) + " (1:1)")
    if t1
        line.set_color(lnBe, color.new(cUp, 30))

// ---------- Vẽ ----------
plotshape(opened and pos == 1 and aBuy, "MUA · quét đáy 20 nến", shape.triangleup, location.belowbar, cUp, size = size.small, text = "MUA")
plotshape(opened and pos == -1 and aSell, "BÁN · quét đỉnh 20 nến", shape.triangledown, location.abovebar, cDn, size = size.small, text = "BÁN")
plotshape(opened and pos == 1 and not aBuy, "MUA · 2–3 đáy + phân kỳ", shape.triangleup, location.belowbar, cUp, size = size.small, text = "MUA\n2-3 đáy")
plotshape(opened and pos == -1 and not aSell, "BÁN · 2–3 đỉnh + phân kỳ", shape.triangledown, location.abovebar, cDn, size = size.small, text = "BÁN\n2-3 đỉnh")
plot(pos != 0 ? sl : na, "Dừng lỗ (kéo theo)", cDn, 2, plot.style_linebr)
alertcondition(opened and pos == 1, "Nhịp Vàng MUA", "XAUUSD MUA ngay sau khi quét thanh khoản")
alertcondition(opened and pos == -1, "Nhịp Vàng BÁN", "XAUUSD BÁN ngay sau khi quét thanh khoản")

// ---------- Hệ 2: phá đỉnh/đáy 20 nến H1 theo xu hướng H4 (chạy song song, dùng chung cảnh báo) ----------
// Nến H1 đóng cửa trên đỉnh 20 nến H1 trước đó khi H4 tăng: MUA ngay (BÁN ngược lại). SL 2 ATR H1.
// Tới 1:1 dời SL về giá vào; từ 1:3 kéo SL cách mức lãi cao nhất 1,5R; chốt hết ở 1:8.
useBo   = input.bool(true, "Hệ 2: phá đỉnh/đáy 20 nến H1 theo H4")
boAtrK  = input.float(2.0, "Hệ 2: dừng lỗ (số ATR H1)", minval = 0.5, step = 0.5)
cBo     = input.color(color.new(#FF9800, 0), "Hệ 2: màu")
boBars() =>
    hi20 = ta.highest(high, 20)[1]
    lo20 = ta.lowest(low, 20)[1]
    a = ta.atr(14)
    [close[1], hi20[1], lo20[1], a[1], time[1]]
[hC, hHi, hLo, hAtr, hT] = request.security(syminfo.tickerid, "60", boBars(), lookahead = barmerge.lookahead_on)
newH1 = hT != hT[1]

var int   bPos  = 0
var float bE    = na
var float bSl   = na
var float bSl0  = na
var float bBe   = na
var float bTr   = na
var float bTp   = na
var float bRisk = na
var float bMx   = 0.0
var bool  bT1   = false
var bool  bTrailOn = false
var int   bW    = 0
var int   bB    = 0
var int   bL    = 0
var float bTot  = 0.0
var label lbBo  = na

bool bOpened = false
if useBo and bPos == 0 and newH1 and not na(hHi)
    bDir = hC > hHi and h4 == 1 ? 1 : hC < hLo and h4 == -1 ? -1 : 0
    if bDir != 0
        bPos  := bDir
        bE    := hC
        bRisk := boAtrK * hAtr
        bSl   := bE - bPos * bRisk
        bSl0  := bSl
        bBe   := bE + bPos * beR * bRisk
        bTr   := bE + bPos * trailAt * bRisk
        bTp   := bE + bPos * tpR * bRisk
        bMx   := 0.0
        bT1   := false
        bTrailOn := false
        bOpened := true
        alert("XAUUSD [Hệ 2 · phá " + (bPos == 1 ? "đỉnh" : "đáy") + " 20 nến H1] " + sideTxt(bPos) + " NGAY " + f(bE) + " | SL " + f(bSl) + " | Hoà vốn tại " + f(bBe) + " | Kéo SL từ " + f(bTr) + " | Tối đa " + f(bTp), alert.freq_once_per_bar)

float bExit = na
string bWhy = ""
if bPos != 0
    bFav = bPos * ((bPos == 1 ? high : low) - bE) / bRisk
    if bPos == 1 ? low <= bSl : high >= bSl
        bExit := bPos * (bSl - bE) / bRisk
        bWhy := bExit < 0 ? "Chạm dừng lỗ" : bExit == 0 ? "Về giá vào (hoà vốn)" : "Chạm SL đã kéo theo lãi"
    else if bFav >= tpR
        bExit := tpR
        bWhy := "Đạt tối đa 1:" + str.tostring(tpR)
    else
        bMx := math.max(bMx, bFav)
        if bFav >= beR and bPos * (bE - bSl) > 0
            bSl := bE
            bT1 := true
            alert("XAUUSD [Hệ 2]: lệnh " + sideTxt(bPos) + " từ " + f(bE) + " đạt 1:1, dời dừng lỗ về giá vào", alert.freq_once_per_bar)
        if bMx >= trailAt
            bNsl = bE + bPos * (bMx - trailGap) * bRisk
            if bPos * (bNsl - bSl) > 0
                if not bTrailOn
                    alert("XAUUSD [Hệ 2]: lệnh " + sideTxt(bPos) + " đạt 1:" + str.tostring(trailAt) + ", bắt đầu kéo dừng lỗ", alert.freq_once_per_bar)
                bTrailOn := true
                bSl := bNsl
if not na(bExit)
    bW   += bExit > 0 ? 1 : 0
    bB   += bExit == 0 ? 1 : 0
    bL   += bExit < 0 ? 1 : 0
    bTot += bExit
    alert("XAUUSD [Hệ 2]: " + bWhy + " · lệnh " + sideTxt(bPos) + " từ " + f(bE) + " · " + str.tostring(bExit, "#.##") + "R", alert.freq_once_per_bar)
    label.new(bar_index, bExit > 0 ? (bPos == 1 ? high : low) : bExit < 0 ? bSl0 : bE, "H2 " + (bExit > 0 ? "+" : "") + str.tostring(bExit, "#.##") + "R", style = label.style_label_center, color = cBo, textcolor = color.white, size = size.small)
    bPos := 0

label.delete(lbBo)
if bPos != 0 and barstate.islast
    lbBo := label.new(bar_index + 3, bE, "HỆ 2 " + sideTxt(bPos) + " " + f(bE) + " | SL " + f(bSl) + (bTrailOn ? " (đang kéo)" : bT1 ? " (ở giá vào)" : "") + " | 1:1 " + f(bBe) + " | kéo SL từ " + f(bTr) + " | tối đa " + f(bTp), style = label.style_label_left, color = cBo, textcolor = color.white, size = size.small)
plotshape(bOpened and bPos == 1, "Hệ 2 MUA", shape.labelup, location.belowbar, cBo, text = "H2", textcolor = color.white, size = size.tiny)
plotshape(bOpened and bPos == -1, "Hệ 2 BÁN", shape.labeldown, location.abovebar, cBo, text = "H2", textcolor = color.white, size = size.tiny)
plot(bPos != 0 ? bSl : na, "Hệ 2 dừng lỗ", cBo, 2, plot.style_linebr)
plot(bPos != 0 ? bE : na, "Hệ 2 giá vào", color.new(cBo, 50), 1, plot.style_linebr)
plot(bPos != 0 ? bTp : na, "Hệ 2 tối đa", color.new(cBo, 60), 1, plot.style_linebr)

var table tb = table.new(position.top_right, 2, 10, bgcolor = color.new(color.black, 20), border_width = 1)
if showTable and barstate.islast
    t = (h4 == 1 ? "Tăng" : h4 == -1 ? "Giảm" : "Đi ngang")
    z = (h1 == 1 ? "Vùng MUA" : h1 == -1 ? "Vùng BÁN" : "Chưa có vùng")
    n = nWin + nBe + nLoss
    table.cell(tb, 0, 0, "H4 xu hướng", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, t, text_color = h4 == 1 ? color.lime : h4 == -1 ? color.red : color.silver, text_size = size.small)
    table.cell(tb, 0, 1, "H1 vùng", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, z, text_color = h1 == 1 ? color.lime : h1 == -1 ? color.red : color.silver, text_size = size.small)
    table.cell(tb, 0, 2, "Lệnh", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, pos != 0 ? sideTxt(pos) + " " + f(entry) + " · " + kindNow + (trailing ? " (đang kéo SL)" : t1 ? " (SL ở giá vào)" : "") : "Chờ tín hiệu", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "SL · tối đa", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, pos == 0 ? "–" : f(sl) + " · " + f(tp), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 4, "Thắng/hoà/thua", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(nWin) + "/" + str.tostring(nBe) + "/" + str.tostring(nLoss) + " (" + str.tostring(n) + " lệnh)", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 5, "Tổng · TB", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(totR, "#.#") + "R · " + (n > 0 ? str.tostring(totR / n, "#.##") : "–") + "R/lệnh", text_color = totR >= 0 ? color.lime : color.red, text_size = size.small)
    table.cell(tb, 0, 6, "Khung", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 6, timeframe.period == "15" ? "M15 ✓" : "Hãy chuyển sang M15", text_color = timeframe.period == "15" ? color.white : color.orange, text_size = size.small)
    bn = bW + bB + bL
    table.cell(tb, 0, 7, "Hệ 2 lệnh", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 7, not useBo ? "Tắt" : bPos != 0 ? sideTxt(bPos) + " " + f(bE) + " · SL " + f(bSl) : h4 == 1 ? "Chờ H1 đóng > " + f(hHi) : h4 == -1 ? "Chờ H1 đóng < " + f(hLo) : "H4 đi ngang", text_color = cBo, text_size = size.small)
    table.cell(tb, 0, 8, "Hệ 2 thống kê", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 9, "Đáy · đỉnh cũ chờ quét", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 9, (na(watchLo) ? "–" : f(watchLo)) + " · " + (na(watchHi) ? "–" : f(watchHi)), text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 8, str.tostring(bW) + "/" + str.tostring(bB) + "/" + str.tostring(bL) + " · " + str.tostring(bTot, "#.#") + "R (" + str.tostring(bn) + " lệnh)", text_color = bTot >= 0 ? color.lime : color.red, text_size = size.small)
